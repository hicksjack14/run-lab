# Copy this file to .env and fill in the values from https://www.strava.com/settings/api
# (.env is gitignored; never commit it)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Spotify live capture (optional): the Client ID from developer.spotify.com/dashboard. No secret needed.
SPOTIFY_CLIENT_ID=

# Optional: log finished albums on Crates (see ingest/crates_sync.py)
CRATES_URL=
CRATES_TOKEN=
